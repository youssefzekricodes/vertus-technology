# Google Apps Script "web app" endpoint that appends contact rows to the sheet.
# See README.md → "Google Sheets integration" for the script to deploy.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Final public domain (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.vertus-technology.com
# Google Analytics 4 measurement ID — loaded only after cookie consent
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification token
NEXT_PUBLIC_GSC_VERIFICATION=
